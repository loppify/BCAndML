  browser -> browser_1 -> browser_2 -> browser_3 -> browser_4 -> browser_5 -> browser_6 -> browser_7 -> browser_8 -> browser_9 -> browser_10 [style=dashed, arrowhead=none, color="#a8b4c2"];
  api -> api_1 -> api_2 -> api_3 -> api_4 -> api_5 -> api_6 -> api_7 -> api_8 -> api_9 -> api_10 [style=dashed, arrowhead=none, color="#a8b4c2"];
  model -> model_1 -> model_2 -> model_3 -> model_4 -> model_5 -> model_6 -> model_7 -> model_8 -> model_9 -> model_10 [style=dashed, arrowhead=none, color="#a8b4c2"];
  oracle -> oracle_1 -> oracle_2 -> oracle_3 -> oracle_4 -> oracle_5 -> oracle_6 -> oracle_7 -> oracle_8 -> oracle_9 -> oracle_10 [style=dashed, arrowhead=none, color="#a8b4c2"];
