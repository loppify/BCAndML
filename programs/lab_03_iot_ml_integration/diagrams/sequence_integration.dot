digraph SequenceIntegration {
  graph [layout=neato, bgcolor="white", pad=0.2, overlap=false, splines=polyline,
         fontname="DejaVu Sans", label="Послідовність фактичної інтеграції: браузер, ML-oracle, EVM та аудит",
         labelloc=t, fontsize=21];
  node [fontname="DejaVu Sans", fontsize=14, pin=true];
  edge [fontname="DejaVu Sans", fontsize=11, color="#52606d", arrowsize=0.7];

  browser [pos="80,760!", shape=box, style="rounded,filled", fillcolor="#edf3ff", color="#4774bf", label="Owner / Browser\nEIP-1193 wallet"];
  api [pos="240,760!", shape=box, style="rounded,filled", fillcolor="#eaf4ff", color="#4774bf", label="FastAPI +\nFeaturePipeline"];
  model [pos="400,760!", shape=box, style="rounded,filled", fillcolor="#fff7e5", color="#d2a144", label="Random Forest\n+ SHAP"];
  oracle [pos="560,760!", shape=box, style="rounded,filled", fillcolor="#e8f5e9", color="#5aa469", label="OracleService\nWeb3 signer"];
  evm [pos="720,760!", shape=box, style="rounded,filled", fillcolor="#f3ecfb", color="#9061a9", label="EVM contracts\nDeviceQuarantine"];
  audit [pos="880,760!", shape=box, style="rounded,filled", fillcolor="#eff4f7", color="#7793a4", label="EventIndexer\n+ SQLite"];

  browser_1 [pos="80,650!", shape=point, style=invis]; browser_2 [pos="80,580!", shape=point, style=invis];
