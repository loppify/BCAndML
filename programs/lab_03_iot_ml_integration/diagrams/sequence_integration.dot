  browser_9 [pos="80,90!", shape=point, style=invis]; browser_10 [pos="80,20!", shape=point, style=invis];
  api_1 [pos="240,650!", shape=point, style=invis]; api_2 [pos="240,580!", shape=point, style=invis];
  api_3 [pos="240,510!", shape=point, style=invis]; api_4 [pos="240,440!", shape=point, style=invis];
  api_5 [pos="240,370!", shape=point, style=invis]; api_6 [pos="240,300!", shape=point, style=invis];
  api_7 [pos="240,230!", shape=point, style=invis]; api_8 [pos="240,160!", shape=point, style=invis];
  api_9 [pos="240,90!", shape=point, style=invis]; api_10 [pos="240,20!", shape=point, style=invis];
  model_1 [pos="400,650!", shape=point, style=invis]; model_2 [pos="400,580!", shape=point, style=invis];
  model_3 [pos="400,510!", shape=point, style=invis]; model_4 [pos="400,440!", shape=point, style=invis];
  model_5 [pos="400,370!", shape=point, style=invis]; model_6 [pos="400,300!", shape=point, style=invis];
  model_7 [pos="400,230!", shape=point, style=invis]; model_8 [pos="400,160!", shape=point, style=invis];
  model_9 [pos="400,90!", shape=point, style=invis]; model_10 [pos="400,20!", shape=point, style=invis];
  oracle_1 [pos="560,650!", shape=point, style=invis]; oracle_2 [pos="560,580!", shape=point, style=invis];
  oracle_3 [pos="560,510!", shape=point, style=invis]; oracle_4 [pos="560,440!", shape=point, style=invis];
  oracle_5 [pos="560,370!", shape=point, style=invis]; oracle_6 [pos="560,300!", shape=point, style=invis];
  oracle_7 [pos="560,230!", shape=point, style=invis]; oracle_8 [pos="560,160!", shape=point, style=invis];
  oracle_9 [pos="560,90!", shape=point, style=invis]; oracle_10 [pos="560,20!", shape=point, style=invis];
  evm_1 [pos="720,650!", shape=point, style=invis]; evm_2 [pos="720,580!", shape=point, style=invis];
  evm_3 [pos="720,510!", shape=point, style=invis]; evm_4 [pos="720,440!", shape=point, style=invis];
  evm_5 [pos="720,370!", shape=point, style=invis]; evm_6 [pos="720,300!", shape=point, style=invis];
  evm_7 [pos="720,230!", shape=point, style=invis]; evm_8 [pos="720,160!", shape=point, style=invis];
  evm_9 [pos="720,90!", shape=point, style=invis]; evm_10 [pos="720,20!", shape=point, style=invis];
  audit_1 [pos="880,650!", shape=point, style=invis]; audit_2 [pos="880,580!", shape=point, style=invis];
  audit_3 [pos="880,510!", shape=point, style=invis]; audit_4 [pos="880,440!", shape=point, style=invis];
