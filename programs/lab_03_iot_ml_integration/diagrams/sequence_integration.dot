  browser_1 -> evm_1 [label="1. register device / grant access\nwallet-signed transaction"];
  browser_2 -> api_2 [label="2. submit device ID + flow"];
  api_3 -> model_3 [label="3. validated feature vector"];
  model_4 -> api_4 [label="4. class + probability + SHAP factors"];
  api_5 -> oracle_5 [label="5. canonical JSON + SHA-256 + model v2"];
  oracle_6 -> evm_6 [label="6. recordDecision(result, bps, v2, inputHash)"];
  evm_7 -> audit_7 [label="7. DecisionRecorded / DeviceQuarantined"];
  audit_8 -> api_8 [label="8. event mirror + receipt"];
  api_9 -> browser_9 [label="9. result + explanation + tx hash"];
  browser_10 -> evm_10 [label="10. read audit history from contract"];
}
